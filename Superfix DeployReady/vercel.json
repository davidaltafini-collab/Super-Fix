{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://api.super-fix.ro/sitemap.xml"
    },
    {
      "source": "/:file(sitemap-[a-z]+-\\d+\\.xml)",
      "destination": "https://api.super-fix.ro/:file"
    },
    { "source": "/hero/:slug/origine", "destination": "/api/ssr?__r=origin&__s=:slug" },
    { "source": "/hero/:slug", "destination": "/api/ssr?__r=hero&__s=:slug" },
    { "source": "/meserii/:a", "destination": "/api/ssr?__r=landing&__p=/meserii/:a" },
    { "source": "/meserii/:a/:b", "destination": "/api/ssr?__r=landing&__p=/meserii/:a/:b" },
    { "source": "/meserii/:a/:b/:c", "destination": "/api/ssr?__r=landing&__p=/meserii/:a/:b/:c" },
    { "source": "/zone/:a", "destination": "/api/ssr?__r=landing&__p=/zone/:a" },
    { "source": "/zone/:a/:b", "destination": "/api/ssr?__r=landing&__p=/zone/:a/:b" },
    { "source": "/og/:path*", "destination": "/api/og?p=:path*" },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com/gsi/style; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://super-fix.ro https://res.cloudinary.com https://*.basemaps.cartocdn.com https://*.googleusercontent.com https://mny.ro; media-src 'self' blob: https://res.cloudinary.com; connect-src 'self' https://api.super-fix.ro https://api.cloudinary.com https://res.cloudinary.com https://nominatim.openstreetmap.org https://photon.komoot.io https://router.project-osrm.org https://routing.openstreetmap.de https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/ https://www.youtube.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=(self), payment=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/heroes",
      "has": [{ "type": "query", "key": "q" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/heroes",
      "has": [{ "type": "query", "key": "meserie" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/heroes",
      "has": [{ "type": "query", "key": "judete" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/admin",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/portal",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/portal/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
